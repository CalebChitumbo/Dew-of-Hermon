rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return getUserRole() in ["SUPER_ADMIN", "VICE_CHAIRPERSON", "ADMIN"];
    }

    function isSuperAdmin() {
      return getUserRole() == "SUPER_ADMIN";
    }

    function isViceChair() {
      return getUserRole() in ["SUPER_ADMIN", "VICE_CHAIRPERSON"];
    }

    function isDeptLead() {
      return getUserRole() in ["SUPER_ADMIN", "VICE_CHAIRPERSON", "ADMIN", "DEPARTMENT_LEAD"];
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // ─── Users ───
    // The `role`, `isActive`, and `leadsDepartmentIds` fields drive the entire
    // RBAC (getUserRole() reads users/{uid}.role). Client SDK writes must never
    // be able to change them — a member editing their own doc could otherwise
    // set role: "SUPER_ADMIN" and take over. All privileged mutations
    // (role/activation/lead changes) go through the Admin-SDK member API, which
    // bypasses these rules. Client writes are limited to profile fields
    // (name/phone) and department membership by leads.
    function userPrivilegedFieldsUnchanged() {
      return request.resource.data.role == resource.data.role
        && request.resource.data.isActive == resource.data.isActive
        && request.resource.data.leadsDepartmentIds == resource.data.leadsDepartmentIds;
    }
    match /users/{userId} {
      allow read: if isSignedIn();
      // Client-created profiles are always plain MEMBERs; elevated accounts are
      // provisioned server-side. Blocks self-provisioned admin at sign-up.
      allow create: if (isOwner(userId) || isAdmin())
        && request.resource.data.role == "MEMBER";
      allow update: if (isOwner(userId) || isDeptLead())
        && userPrivilegedFieldsUnchanged();
      allow delete: if isSuperAdmin();

      // Self-service availability: users manage their own unavailable dates.
      match /availability/{dateId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isOwner(userId) || isAdmin();
      }
    }

    // ─── Departments ───
    match /departments/{deptId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ─── Service Roles (templates) ───
    match /serviceRoles/{roleId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ─── Events ───
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ─── Services ───
    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();

      match /assignments/{assignmentId} {
        allow read: if isSignedIn();
        allow create, update: if isDeptLead();
        allow delete: if isSuperAdmin();
      }

      match /checklist/{itemId} {
        allow read: if isSignedIn();
        allow create: if isAdmin();
        allow update: if isSignedIn();
        allow delete: if isSuperAdmin();
      }
    }

    // ─── Service Assignments (top-level) ───
    match /serviceAssignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create: if isDeptLead();
      // Allow dept leads to update any assignment, and users to confirm/decline their own
      allow update: if isDeptLead() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isSuperAdmin();
    }

    // ─── Affirmations ───
    match /affirmations/{affId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ─── Campus Devotionals ───
    // Read by anyone signed in. Writes go through the API, which enforces
    // the manage_devotionals feature permission for the Campus Ministry lead.
    match /devotionals/{devId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ─── Notifications ───
    // Notifications are created server-side via the Admin SDK (which bypasses
    // these rules), so client creation is closed off entirely — this also
    // stops an admin from forging notifications to other users from the
    // browser. Recipients may only mark their own notification read; they
    // cannot rewrite its contents.
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["isRead", "readAt"]);
      allow create: if false;
    }

    // ─── Mail (Firebase Trigger Email extension) ───
    // Admin SDK handles writes; admins can read for delivery status monitoring
    match /mail/{mailId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─── Department Tasks ───
    match /departmentTasks/{taskId} {
      allow read: if isSignedIn();
      allow create, update: if isDeptLead();
      allow delete: if isSuperAdmin();
    }

    // ─── Transport Requests ───
    // Reads are open to all signed-in users so request status can be surfaced
    // next to the event in the approval queue. All writes flow through the
    // API which enforces workflow transitions and role gating.
    match /transportRequests/{requestId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ─── Budget Requests ───
    // Extra-funds requests submitted with an event for the treasurer to
    // confirm. Same access pattern as transport requests — reads open,
    // writes through the API only.
    match /budgetRequests/{requestId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ─── Media Requests ───
    // Event media requests for the Media coordinator to assign Sound,
    // Publicity, and Coverage. Reads open; writes through the API only.
    match /mediaRequests/{requestId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ─── Food Requests ───
    // Event catering requests for the Food Logistics lead to plan and confirm.
    // Reads open; writes through the API only.
    match /foodRequests/{requestId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ─── Reminder Logs ───
    match /reminderLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─── Event Department Roles ───
    match /eventDepartmentRoles/{roleId} {
      allow read: if isSignedIn();
      allow create, update: if isDeptLead();
      allow delete: if isSuperAdmin();
    }

    // ─── Event Reports (Post-Event Reporting) ───
    // The initiator can read their own report; admins/dept leads can read all
    // (the API still gates which UI surfaces show reports to whom). All writes
    // flow through the API which enforces ownership, workflow transitions, and
    // denormalization of event metadata.
    match /eventReports/{reportId} {
      allow read: if isSignedIn() && (
        resource.data.initiatorId == request.auth.uid || isDeptLead()
      );
      allow write: if false;
    }

    // ─── Follow-Up Cards ───
    // Cards hold pastoral PII (contact name, phone, private notes, and reasons
    // such as NEEDS_PASTORAL_SUPPORT). Reads are limited to the card's creator,
    // its assignee, and dept leads/admins — not every signed-in member. (The
    // dashboard tolerates a denied read; the discipleship board falls back to
    // the Admin-SDK API.)
    match /followUpCards/{cardId} {
      allow read: if isSignedIn() && (
        resource.data.createdBy == request.auth.uid
        || resource.data.assigneeId == request.auth.uid
        || isDeptLead()
      );
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid;
      // Dept leads can update any card. The assignee can advance their own card
      // but only the status/notes fields — they must not be able to self-approve
      // by writing approvedBy/approvedAt (those flow through the approve API).
      allow update: if isDeptLead()
        || (isSignedIn() && resource.data.assigneeId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(["status", "notes", "statusHistory", "updatedAt"]));
      allow delete: if isSuperAdmin();
    }

    // ─── Department Join Requests ───
    // A member's request to join a department, flowing through the
    // Manager → Chairperson approval chain. The requester can read their own
    // request; department leads (and admins/chair) can read all so the
    // approval queue works. All writes go through the API, which enforces
    // the workflow transitions, role gating, and department-membership update.
    match /departmentJoinRequests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isDeptLead()
      );
      allow write: if false;
    }

    // ─── Institutions ───
    match /institutions/{instId} {
      allow read: if true; // Public — needed for registration form (unauthenticated users)
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ─── Settings (Life Groups, etc.) ───
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ─── ROPs Camp Registrations ───
    // Registrations are submitted through /api/camp-registrations (Admin SDK,
    // which validates the payload and enforces capacity), so direct client
    // writes are closed off. Reads and updates (e.g. marking paid/unpaid) are
    // admin-only. Hard-deletion of registrations is reserved for the
    // Chairperson.
    match /campRegistrations/{regId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ─── ROPs Camp Settings (per-camp capacity override) ───
    // Holds admin overrides of the static camp catalog — currently the
    // maximum registration capacity. Written only through
    // /api/camp-registrations/capacity (Admin SDK), which checks the
    // camp-management permission and refuses a cap below the campers already
    // registered; a client that could write here could reopen or close
    // registration at will. Reads go through the same API (the public
    // registration page reads the cap from the capacity endpoint).
    match /campSettings/{campId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─── ROPs Camp Sponsorships ───
    // Sponsorship pledges are submitted through /api/camp-sponsorships
    // (Admin SDK, which validates the payload and derives slot counts), so
    // direct client writes are closed off. Reads and updates (payments,
    // assigning campers to slots) are admin-only; hard-deletion is reserved
    // for the Chairperson.
    match /campSponsorships/{sponsorshipId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ─── ROPs Camp Announcements ───
    // One document per announcement sent to campers, holding the message as
    // typed (placeholders unresolved) and the per-camper delivery result.
    // Everything is written through /api/camp-broadcasts (Admin SDK), which
    // checks the camp-management permission and does the sending, so direct
    // client writes are closed off — a client that could write here could
    // fabricate a send record. Reads are admin-only: the outcomes carry camper
    // names and the addresses their mail went to.
    match /campBroadcasts/{broadcastId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─── ROPs Camp Exit Passes ───
    // The PASS system: a camper's request to leave camp, signed off by
    // Admissions → Camp Manager → Chairperson, then scanned out and back in at
    // the gate. EVERY write goes through /api/camp-passes (Admin SDK), which
    // enforces the stage permissions and applies the gate scan inside a
    // transaction so a pass can never be used more than once each way. Direct
    // client writes are closed off completely — a client that could edit a pass
    // could approve its own exit or reset a spent code. Reads are closed too
    // (the `passCode` is a bearer token for leaving camp); campers and staff
    // both read passes through the API, which decides who may see a code.
    match /campPasses/{passId} {
      allow read: if false;
      allow write: if false;
    }

    // ─── ROPs Camp Meal Register ───
    // One document per camper per meal sitting, id'd deterministically as
    // `${campId}_${date}_${slot}_${registrationId}`. Every write goes through
    // /api/camp-meals (Admin SDK), which create()s that id so a replayed
    // offline scan or two serving lines scanning at once can never record a
    // second helping. Direct client writes are closed off: a client that could
    // write here could forge or delete its own meal record, and a client that
    // could pick the document id could sidestep the collision that makes the
    // whole scheme safe. Reads are admin-only — these rows carry camper names
    // and allergy notes.
    match /campMealScans/{scanId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─── Fundraising Braai ───
    // Events and assignments for Sunday fundraising braais. Writes always go
    // through the API (which checks the Fundraising department lead rule),
    // but reads need to be permissive so members can see their own assignments
    // and the live dashboard tally on the chairperson's screen.
    match /braaiEvents/{eventId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /braaiAssignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create: if isDeptLead();
      // Dept leads (and admins) can update any assignment; an assignee can
      // confirm/decline their own braai duty without needing planner rights.
      allow update: if isDeptLead()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isSuperAdmin();
    }

    // ─── Fundraising Orders (Potter's Shockers public ordering) ───
    // All writes go through the API (which validates the payload, recomputes
    // the total, generates the order number, and gates updates on the
    // manage_fundraising_orders feature). Reads are open to signed-in users so
    // the shared workflow view inside Fundraising shows live order state.
    match /fundraisingOrders/{orderId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Hardcoded menu items with editable prices and the MoMo number. The
    // public order page reads this through the public API endpoint (server
    // uses the Admin SDK and bypasses these rules); signed-in users may also
    // read it directly. Writes flow through the admin-gated menu API.
    match /fundraisingConfig/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ─── Worship Song Suggestions (Latreou) ───
    // Any signed-in user can read & propose suggestions. Worship leads (and
    // admins) can update (archive / restore). Hard-deletion of suggestions is
    // reserved for the Chairperson (SUPER_ADMIN) so members and leads can't
    // remove records from the audit log.
    match /worshipSongSuggestions/{suggestionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.suggestedBy == request.auth.uid
        && request.resource.data.status == "open";
      allow update: if isDeptLead();
      allow delete: if isSuperAdmin();
    }

    // ─── Talent Submissions ───
    // A member putting their talent forward for leadership to review and
    // slot into an opportunity. The submitter can read their own submission;
    // dept leads and admins can read all so the review queue and talent pool
    // work. All writes go through the API, which enforces the workflow
    // transitions and role gating.
    match /talentSubmissions/{submissionId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isDeptLead()
      );
      allow write: if false;
    }

    // ─── Bible Bookmarks & Highlights ───
    // Private to each user: saved/highlighted verses in the Bible reader. A
    // user may only read and write their own bookmarks, and every document
    // must be stamped with their own uid.
    match /bibleBookmarks/{bookmarkId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
    }
  }
}
