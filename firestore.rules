rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return getUserRole() in ["SUPER_ADMIN", "VICE_CHAIRPERSON", "ADMIN"];
    }

    function isSuperAdmin() {
      return getUserRole() == "SUPER_ADMIN";
    }

    function isViceChair() {
      return getUserRole() in ["SUPER_ADMIN", "VICE_CHAIRPERSON"];
    }

    function isDeptLead() {
      return getUserRole() in ["SUPER_ADMIN", "VICE_CHAIRPERSON", "ADMIN", "DEPARTMENT_LEAD"];
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // ─── Users ───
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isDeptLead();
      allow delete: if isSuperAdmin();

      match /availabilities/{dateId} {
        allow read: if isSignedIn();
        allow create, update: if isOwner(userId) || isAdmin();
        allow delete: if isSuperAdmin();
      }
    }

    // ─── Departments ───
    match /departments/{deptId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ─── Service Roles (templates) ───
    match /serviceRoles/{roleId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ─── Events ───
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ─── Services ───
    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();

      match /assignments/{assignmentId} {
        allow read: if isSignedIn();
        allow create, update: if isDeptLead();
        allow delete: if isSuperAdmin();
      }

      match /checklist/{itemId} {
        allow read: if isSignedIn();
        allow create: if isAdmin();
        allow update: if isSignedIn();
        allow delete: if isSuperAdmin();
      }
    }

    // ─── Service Assignments (top-level) ───
    match /serviceAssignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create: if isDeptLead();
      // Allow dept leads to update any assignment, and users to confirm/decline their own
      allow update: if isDeptLead() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isSuperAdmin();
    }

    // ─── Affirmations ───
    match /affirmations/{affId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ─── Campus Devotionals ───
    // Read by anyone signed in. Writes go through the API, which enforces
    // the manage_devotionals feature permission for the Campus Ministry lead.
    match /devotionals/{devId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ─── Notifications ───
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isAdmin();
    }

    // ─── Mail (Firebase Trigger Email extension) ───
    // Admin SDK handles writes; admins can read for delivery status monitoring
    match /mail/{mailId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─── Department Tasks ───
    match /departmentTasks/{taskId} {
      allow read: if isSignedIn();
      allow create, update: if isDeptLead();
      allow delete: if isSuperAdmin();
    }

    // ─── Transport Requests ───
    // Reads are open to all signed-in users so request status can be surfaced
    // next to the event in the approval queue. All writes flow through the
    // API which enforces workflow transitions and role gating.
    match /transportRequests/{requestId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ─── Budget Requests ───
    // Extra-funds requests submitted with an event for the treasurer to
    // confirm. Same access pattern as transport requests — reads open,
    // writes through the API only.
    match /budgetRequests/{requestId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ─── Media Requests ───
    // Event media requests for the Media coordinator to assign Sound,
    // Publicity, and Coverage. Reads open; writes through the API only.
    match /mediaRequests/{requestId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ─── Food Requests ───
    // Event catering requests for the Food Logistics lead to plan and confirm.
    // Reads open; writes through the API only.
    match /foodRequests/{requestId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ─── Reminder Logs ───
    match /reminderLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─── Event Department Roles ───
    match /eventDepartmentRoles/{roleId} {
      allow read: if isSignedIn();
      allow create, update: if isDeptLead();
      allow delete: if isSuperAdmin();
    }

    // ─── Event Reports (Post-Event Reporting) ───
    // The initiator can read their own report; admins/dept leads can read all
    // (the API still gates which UI surfaces show reports to whom). All writes
    // flow through the API which enforces ownership, workflow transitions, and
    // denormalization of event metadata.
    match /eventReports/{reportId} {
      allow read: if isSignedIn() && (
        resource.data.initiatorId == request.auth.uid || isDeptLead()
      );
      allow write: if false;
    }

    // ─── Follow-Up Cards ───
    match /followUpCards/{cardId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      // Dept leads can update any card; the assignee can update their own
      // (status/notes) so Youth Leaders can advance contacts assigned to them.
      allow update: if isDeptLead()
        || (isSignedIn() && resource.data.assigneeId == request.auth.uid);
      allow delete: if isSuperAdmin();
    }

    // ─── Department Join Requests ───
    // A member's request to join a department, flowing through the
    // Manager → Chairperson approval chain. The requester can read their own
    // request; department leads (and admins/chair) can read all so the
    // approval queue works. All writes go through the API, which enforces
    // the workflow transitions, role gating, and department-membership update.
    match /departmentJoinRequests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isDeptLead()
      );
      allow write: if false;
    }

    // ─── Institutions ───
    match /institutions/{instId} {
      allow read: if true; // Public — needed for registration form (unauthenticated users)
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ─── Settings (Life Groups, etc.) ───
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ─── ROPs Camp Registrations ───
    // Anyone can submit a registration (public form). Reads and updates
    // (e.g. marking paid/unpaid) are admin-only and go through the API.
    // Hard-deletion of registrations is reserved for the Chairperson.
    match /campRegistrations/{regId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.paymentStatus == "UNPAID";
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ─── Fundraising Braai ───
    // Events and assignments for Sunday fundraising braais. Writes always go
    // through the API (which checks the Fundraising department lead rule),
    // but reads need to be permissive so members can see their own assignments
    // and the live dashboard tally on the chairperson's screen.
    match /braaiEvents/{eventId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /braaiAssignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create: if isDeptLead();
      // Dept leads (and admins) can update any assignment; an assignee can
      // confirm/decline their own braai duty without needing planner rights.
      allow update: if isDeptLead()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isSuperAdmin();
    }

    // ─── Fundraising Orders (Potter's Shockers public ordering) ───
    // All writes go through the API (which validates the payload, recomputes
    // the total, generates the order number, and gates updates on the
    // manage_fundraising_orders feature). Reads are open to signed-in users so
    // the shared workflow view inside Fundraising shows live order state.
    match /fundraisingOrders/{orderId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Hardcoded menu items with editable prices and the MoMo number. The
    // public order page reads this through the public API endpoint (server
    // uses the Admin SDK and bypasses these rules); signed-in users may also
    // read it directly. Writes flow through the admin-gated menu API.
    match /fundraisingConfig/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ─── Worship Song Suggestions (Latreou) ───
    // Any signed-in user can read & propose suggestions. Worship leads (and
    // admins) can update (archive / restore). Hard-deletion of suggestions is
    // reserved for the Chairperson (SUPER_ADMIN) so members and leads can't
    // remove records from the audit log.
    match /worshipSongSuggestions/{suggestionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.suggestedBy == request.auth.uid
        && request.resource.data.status == "open";
      allow update: if isDeptLead();
      allow delete: if isSuperAdmin();
    }

    // ─── Bible Bookmarks & Highlights ───
    // Private to each user: saved/highlighted verses in the Bible reader. A
    // user may only read and write their own bookmarks, and every document
    // must be stamped with their own uid.
    match /bibleBookmarks/{bookmarkId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
    }
  }
}
