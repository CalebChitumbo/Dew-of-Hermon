rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return getUserRole() in ["SUPER_ADMIN", "ADMIN"];
    }

    function isSuperAdmin() {
      return getUserRole() == "SUPER_ADMIN";
    }

    function isDeptLead() {
      return getUserRole() in ["SUPER_ADMIN", "ADMIN", "DEPARTMENT_LEAD"];
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // ─── Users ───
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isDeptLead();
      allow delete: if isSuperAdmin();

      match /availabilities/{dateId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    // ─── Departments ───
    match /departments/{deptId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ─── Service Roles (templates) ───
    match /serviceRoles/{roleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── Events ───
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ─── Services ───
    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();

      match /assignments/{assignmentId} {
        allow read: if isSignedIn();
        allow create, update: if isDeptLead();
        allow delete: if isAdmin();
      }

      match /checklist/{itemId} {
        allow read: if isSignedIn();
        allow create, delete: if isAdmin();
        allow update: if isSignedIn();
      }
    }

    // ─── Service Assignments (top-level) ───
    match /serviceAssignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create: if isDeptLead();
      // Allow dept leads to update any assignment, and users to confirm/decline their own
      allow update: if isDeptLead() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isDeptLead();
    }

    // ─── Affirmations ───
    match /affirmations/{affId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── Campus Devotionals ───
    // Read by anyone signed in. Writes go through the API, which enforces
    // the manage_devotionals feature permission for the Campus Ministry lead.
    match /devotionals/{devId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── Notifications ───
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isAdmin();
    }

    // ─── Mail (Firebase Trigger Email extension) ───
    // Admin SDK handles writes; admins can read for delivery status monitoring
    match /mail/{mailId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─── Department Tasks ───
    match /departmentTasks/{taskId} {
      allow read: if isSignedIn();
      allow create, update: if isDeptLead();
      allow delete: if isDeptLead();
    }

    // ─── Transport Requests ───
    // Reads are open to all signed-in users so request status can be surfaced
    // next to the event in the approval queue. All writes flow through the
    // API which enforces workflow transitions and role gating.
    match /transportRequests/{requestId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ─── Reminder Logs ───
    match /reminderLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─── Event Department Roles ───
    match /eventDepartmentRoles/{roleId} {
      allow read: if isSignedIn();
      allow create, update: if isDeptLead();
      allow delete: if isAdmin();
    }

    // ─── Event Reports (Post-Event Reporting) ───
    // The initiator can read their own report; admins/dept leads can read all
    // (the API still gates which UI surfaces show reports to whom). All writes
    // flow through the API which enforces ownership, workflow transitions, and
    // denormalization of event metadata.
    match /eventReports/{reportId} {
      allow read: if isSignedIn() && (
        resource.data.initiatorId == request.auth.uid || isDeptLead()
      );
      allow write: if false;
    }

    // ─── Follow-Up Cards ───
    match /followUpCards/{cardId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      // Dept leads can update any card; the assignee can update their own
      // (status/notes) so Youth Leaders can advance contacts assigned to them.
      allow update: if isDeptLead()
        || (isSignedIn() && resource.data.assigneeId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ─── Institutions ───
    match /institutions/{instId} {
      allow read: if true; // Public — needed for registration form (unauthenticated users)
      allow write: if isAdmin();
    }

    // ─── Settings (Life Groups, etc.) ───
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── ROPs Camp Registrations ───
    // Anyone can submit a registration (public form). Reads and updates
    // (e.g. marking paid/unpaid) are admin-only and go through the API.
    match /campRegistrations/{regId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.paymentStatus == "UNPAID";
      allow update, delete: if isAdmin();
    }

    // ─── Fundraising Braai ───
    // Events and assignments for Sunday fundraising braais. Writes always go
    // through the API (which checks the Fundraising department lead rule),
    // but reads need to be permissive so members can see their own assignments
    // and the live dashboard tally on the chairperson's screen.
    match /braaiEvents/{eventId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /braaiAssignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create: if isDeptLead();
      // Dept leads (and admins) can update any assignment; an assignee can
      // confirm/decline their own braai duty without needing planner rights.
      allow update: if isDeptLead()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isDeptLead();
    }

    // ─── Worship Song Suggestions (Latreou) ───
    // Any signed-in user can read & propose suggestions. Suggesters can delete
    // their own open submission. Worship leads (and admins) can update
    // (archive / restore) and delete any suggestion.
    match /worshipSongSuggestions/{suggestionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.suggestedBy == request.auth.uid
        && request.resource.data.status == "open";
      allow update: if isDeptLead();
      allow delete: if isDeptLead()
        || (isSignedIn() && resource.data.suggestedBy == request.auth.uid);
    }
  }
}
