rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return getUserRole() in ["SUPER_ADMIN", "ADMIN"];
    }

    function isSuperAdmin() {
      return getUserRole() == "SUPER_ADMIN";
    }

    function isDeptLead() {
      return getUserRole() in ["SUPER_ADMIN", "ADMIN", "DEPARTMENT_LEAD"];
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // ─── Users ───
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isSuperAdmin();

      match /availabilities/{dateId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    // ─── Departments ───
    match /departments/{deptId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ─── Service Roles (templates) ───
    match /serviceRoles/{roleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── Events ───
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ─── Services ───
    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();

      match /assignments/{assignmentId} {
        allow read: if isSignedIn();
        allow create, update: if isDeptLead();
        allow delete: if isAdmin();
      }

      match /checklist/{itemId} {
        allow read: if isSignedIn();
        allow create, delete: if isAdmin();
        allow update: if isSignedIn();
      }
    }

    // ─── Service Assignments (top-level) ───
    match /serviceAssignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create, update: if isDeptLead();
      allow delete: if isAdmin();
    }

    // ─── Affirmations ───
    match /affirmations/{affId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── Notifications ───
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isAdmin();
    }

    // ─── Reminder Logs ───
    match /reminderLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
