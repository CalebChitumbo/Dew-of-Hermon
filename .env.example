# ═══════════════════════════════════════════════════════════════
# DEW OF HERMON — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# WHERE TO FIND EACH VALUE:
# ─────────────────────────────────────────────────────────────

# ─── Firebase Client ───
# Firebase Console → Project Settings (gear icon) → General → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY="paste-your-api-key-here"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="paste-sender-id-here"
NEXT_PUBLIC_FIREBASE_APP_ID="paste-app-id-here"

# ─── Firebase Admin (Server-side only — NEVER expose to browser) ───
# Firebase Console → Project Settings → Service Accounts → Generate new private key
# Open the downloaded JSON and copy these two fields:
FIREBASE_ADMIN_PROJECT_ID="your-project-id"
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE-YOUR-FULL-KEY-HERE\n-----END PRIVATE KEY-----"

# ─── Email (Resend) ───
# resend.com → API Keys → Create API Key
RESEND_API_KEY="re_paste-your-key-here"
EMAIL_FROM="Dew of Hermon <potterswheel@yourdomain.com>"

# ─── Cron Security ───
# Pre-generated for you. Change if you want.
CRON_SECRET="32a1434f9ed27d0ac39657d57095189b57229d1d12beba36e5a6f33c1db7aaa5"

# ─── App ───
NEXT_PUBLIC_APP_NAME="Dew of Hermon"
NEXT_PUBLIC_APP_URL="https://your-app-name.vercel.app"
