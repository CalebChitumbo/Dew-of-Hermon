# ─── Firebase Client (from Firebase Console → Project Settings → Web App) ───
NEXT_PUBLIC_FIREBASE_API_KEY="AIza..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="potterswheel.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="potterswheel"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="potterswheel.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789:web:abc123"

# ─── Firebase Admin (from Firebase Console → Project Settings → Service Accounts) ───
FIREBASE_ADMIN_PROJECT_ID="potterswheel"
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk-xxxxx@potterswheel.iam.gserviceaccount.com"
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ─── Email (from resend.com) ───
RESEND_API_KEY="re_xxxxxxxxx"
# Use "Dew of Hermon <onboarding@resend.dev>" for testing (sends only to your Resend account email)
# Use "Your Name <you@yourverifieddomain.com>" once you've verified a domain in Resend
EMAIL_FROM="Dew of Hermon <onboarding@resend.dev>"

# ─── Cron Security ───
CRON_SECRET="generate-a-random-32-character-string"

# ─── App ───
NEXT_PUBLIC_APP_NAME="Potter's Wheel"
NEXT_PUBLIC_APP_URL="https://potters-wheel.vercel.app"
